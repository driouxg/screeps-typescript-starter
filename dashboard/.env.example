# Copy to .env.local and fill in. These stay on the server: the browser only talks to this app's /api routes.

# Sign-in for the dashboard (its login page; any username unless DASHBOARD_USERNAME is set too).
# Required in production: without it a deployed dashboard refuses every request. Optional for `npm run dev`.
DASHBOARD_PASSWORD=
# DASHBOARD_USERNAME=
# Signs the session cookie (a long random string). Defaults to the password, so changing that signs everyone out;
# set this to sign everyone out without changing the password.
# DASHBOARD_SESSION_SECRET=

# Official server: https://screeps.com and a token from https://screeps.com/a/#!/account/auth-tokens
# (give it access to "Memory" and "Segments"). Shard the bot runs on, e.g. shard3.
SCREEPS_URL=https://screeps.com
SCREEPS_TOKEN=
SCREEPS_SHARD=shard3

# Private server instead (screepsmod-auth): its address, and the username/password set with setPassword().
# Leave SCREEPS_TOKEN and SCREEPS_SHARD empty.
# SCREEPS_URL=http://localhost:21025
# SCREEPS_USERNAME=
# SCREEPS_PASSWORD=

# No server at all: read a snapshot file instead (e.g. one the bench writes, bench/results/<label>.dashboard.json).
# Control changes are then kept in .mock-controls.json next to this app.
# SCREEPS_SNAPSHOT_FILE=../bench/results/dash-sample.dashboard.json

# How often the page refreshes, in seconds (the official server allows 360 segment reads an hour).
NEXT_PUBLIC_REFRESH_SECONDS=15
